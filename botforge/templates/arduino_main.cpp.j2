{% for inc in includes %}
#include <{{ inc }}>
{% endfor %}

#define MAX_DISTANCE 200

// ---------------------------------------------------------------------------
// Speed helper
// DSL uses speed as a percentage (0–100).
// Arduino analogWrite() expects PWM (0–255).
// ---------------------------------------------------------------------------
int normalizeSpeed(int pct) {
    if (pct <= 0)   return 0;
    if (pct >= 100) return 255;
    return (pct * 255) / 100;
}

{% for sensor in ultrasonics %}
NewPing {{ sensor.name }}({{ sensor.pins.trigger }}, {{ sensor.pins.echo }}, MAX_DISTANCE);
{% endfor %}

{% for sensor in ir_sensors %}
// {{ sensor.kind }}: {{ sensor.name }} on pin {{ sensor.pins.pin }}
{% endfor %}

{% for servo in servos %}
Servo {{ servo.name }};
{% endfor %}

{% if has_wheels %}
// ---------------------------------------------------------------------------
// Wheels — differential drive wrapper
// ---------------------------------------------------------------------------
class Wheels {
public:
    Wheels(int lFwd, int lRev, int rFwd, int rRev)
        : lFwd(lFwd), lRev(lRev), rFwd(rFwd), rRev(rRev) {}

    void forward(int pwm) {
        analogWrite(lFwd, pwm); analogWrite(rFwd, pwm);
        analogWrite(lRev, 0);   analogWrite(rRev, 0);
    }
    void backward(int pwm) {
        analogWrite(lRev, pwm); analogWrite(rRev, pwm);
        analogWrite(lFwd, 0);   analogWrite(rFwd, 0);
    }
    void turnLeft(int pwm) {
        analogWrite(lRev, pwm); analogWrite(rFwd, pwm);
        analogWrite(lFwd, 0);   analogWrite(rRev, 0);
    }
    void turnRight(int pwm) {
        analogWrite(lFwd, pwm); analogWrite(rRev, pwm);
        analogWrite(lRev, 0);   analogWrite(rFwd, 0);
    }
    void stop() {
        analogWrite(lFwd, 0); analogWrite(lRev, 0);
        analogWrite(rFwd, 0); analogWrite(rRev, 0);
    }

private:
    int lFwd, lRev, rFwd, rRev;
};

{% set wp = wheels.pins %}
Wheels wheels({{ wp.left[0] }}, {{ wp.left[1] }}, {{ wp.right[0] }}, {{ wp.right[1] }});
{% endif %}

// ---------------------------------------------------------------------------
// Arduino entry points
// ---------------------------------------------------------------------------
void setup() {
{% for servo in servos %}
    {{ servo.name }}.attach({{ servo.pins.pin }});
{% endfor %}
{% for sensor in ir_sensors %}
    pinMode({{ sensor.pins.pin }}, INPUT);
{% endfor %}
}

void loop() {
{% for line in loop_lines %}
{{ line }}
{% endfor %}
}
