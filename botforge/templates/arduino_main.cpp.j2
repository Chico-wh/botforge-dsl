// =============================================================================
// Generated by BotForge — DO NOT EDIT MANUALLY
// Bot: {{ bot_name }}
// Target: Arduino
// =============================================================================

{% for inc in includes %}
#include <{{ inc }}>
{% endfor %}

#define MAX_DISTANCE 200

{% for sensor in ultrasonics %}
NewPing {{ sensor.name }}({{ sensor.pins.trigger }}, {{ sensor.pins.echo }}, MAX_DISTANCE);
{% endfor %}

{% for servo in servos %}
Servo {{ servo.name }};
{% endfor %}

{% if has_wheels %}
// ---------------------------------------------------------------------------
// Wheels class
// ---------------------------------------------------------------------------
class Wheels {
public:
    Wheels(int leftPin1, int leftPin2, int rightPin1, int rightPin2)
        : leftPin1(leftPin1), leftPin2(leftPin2),
          rightPin1(rightPin1), rightPin2(rightPin2) {}

    void forward(int speed) {
        analogWrite(leftPin1, speed);
        analogWrite(rightPin1, speed);
        analogWrite(leftPin2, 0);
        analogWrite(rightPin2, 0);
    }

    void backward(int speed) {
        analogWrite(leftPin2, speed);
        analogWrite(rightPin2, speed);
        analogWrite(leftPin1, 0);
        analogWrite(rightPin1, 0);
    }

    void turnLeft(int speed) {
        analogWrite(leftPin2, speed);
        analogWrite(rightPin1, speed);
        analogWrite(leftPin1, 0);
        analogWrite(rightPin2, 0);
    }

    void turnRight(int speed) {
        analogWrite(leftPin1, speed);
        analogWrite(rightPin2, speed);
        analogWrite(leftPin2, 0);
        analogWrite(rightPin1, 0);
    }

    void stop() {
        analogWrite(leftPin1, 0);
        analogWrite(leftPin2, 0);
        analogWrite(rightPin1, 0);
        analogWrite(rightPin2, 0);
    }

private:
    int leftPin1, leftPin2, rightPin1, rightPin2;
};

{% set wp = wheels.pins %}
Wheels wheels({{ wp.left[0] }}, {{ wp.left[1] }}, {{ wp.right[0] }}, {{ wp.right[1] }});
{% endif %}

// ---------------------------------------------------------------------------
// Arduino entry points
// ---------------------------------------------------------------------------
void setup() {
{% for servo in servos %}
    {{ servo.name }}.attach({{ servo.pins.pin }});
{% endfor %}
}

void loop() {
{% for line in loop_lines %}
{{ line }}
{% endfor %}
}
